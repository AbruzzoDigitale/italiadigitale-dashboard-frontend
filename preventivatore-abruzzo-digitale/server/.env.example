# Copia questo file in "server/.env" e compila i valori.
# server/.env NON viene mai committato (vedi .gitignore).

# Porta del backend locale
PORT=4321

# Segreto per firmare i token JWT (stringa lunga e casuale)
JWT_SECRET=cambia-questo-con-una-stringa-lunga-e-casuale

# ----- Fatture in Cloud (obiettivo 2: proxy) -----
# Personal Access Token e Company ID restano SOLO qui, lato server.
FIC_ACCESS_TOKEN=
FIC_COMPANY_ID=
